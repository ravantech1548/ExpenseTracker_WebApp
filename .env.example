# Copy this file to .env and fill in real values. .env is ignored by Git.

# Database password (choose a long random value)
POSTGRES_PASSWORD=change-me

# First admin account, created on first start. Password: at least 10 characters.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please

# Google sign-in: OAuth client ID from Google Cloud Console. Leave empty to hide the Google button.
GOOGLE_CLIENT_ID=

# Set to true once the site is served over HTTPS
COOKIE_SECURE=false

# Port the website listens on
WEB_PORT=80
